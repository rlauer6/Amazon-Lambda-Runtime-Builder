package Amazon::Lambda::Runtime::Builder::Role::Config;

use strict;
use warnings;

use CLI::Simple::Constants qw(:booleans);
use Data::Dumper;
use English qw(-no_match_vars);
use List::Util qw(pairs);

use Role::Tiny;

########################################################################
sub _env_file {
########################################################################
  my ($self) = @_;

  my $config = $self->get_config_file // 'lambda.env';

  return $config =~ /[.]ya?ml$/xsm
    ? $config =~ s/[.]ya?ml$/.env/r
    : $config;
}

########################################################################
sub _yaml_file {
########################################################################
  my ($self) = @_;

  my $config = $self->get_config_file // 'lambda.env';

  return $config =~ /[.]ya?ml$/xsm
    ? $config
    : $config =~ s/[.]env$/.yaml/r;
}

########################################################################
sub _yaml_get {
########################################################################
  my ( $node, $path ) = @_;

  foreach my $key ( split /[.]/xsm, $path ) {
    return
      if !ref $node || !exists $node->{$key};

    $node = $node->{$key};
  }

  return $node;
}

########################################################################
sub _mapping_subst {
########################################################################
  my ( $self, $config ) = @_;

  # Values that may be referenced as @FIELD@ in mapping defaults. Read
  # from the user's parsed config, falling back to the same base default
  # the mapping would otherwise use, so e.g. REPO_NAME still derives
  # sensibly when the user didn't set lambda.name. Loaded WITHOUT
  # substitution here to read the base default (no recursion).
  my $base = $self->_load_mapping;

  my %default = map { $_->{env} => $_->{default} }
    grep { defined $_->{env} && exists $_->{default} } @{ $base->{mapping} };

  my $function_name = _yaml_get( $config, 'lambda.name' ) // $default{FUNCTION_NAME};

  return { FUNCTION_NAME => $function_name };
}

########################################################################
sub _load_mapping {
########################################################################
  my ( $self, $subst ) = @_;

  require YAML::Tiny;

  my $dist_dir     = $self->get_dist_dir;
  my $mapping_file = "$dist_dir/lambda-mapping.yml";

  # Slurp the raw mapping text and interpolate @FIELD@ tokens (e.g.
  # REPO_NAME default '@FUNCTION_NAME@') BEFORE parsing. Substituting on
  # the text means:
  #   - the parsed defaults are already concrete (no post-parse walk),
  #   - YAML never sees a bare '@' (which it rejects as a plain-scalar
  #     indicator), so the mapping defaults don't need quoting.
  # $subst holds values resolved from the user's lambda.yaml/lambda.env,
  # read independently and passed in by the caller.
  $subst //= {};

  open my $fh, '<', $mapping_file
    or die "ERROR: could not open $mapping_file\n$OS_ERROR";

  my $text = do { local $RS = undef; <$fh> };

  close $fh;

  # A token with no supplied value is left as-is; if it survives into a
  # value that becomes an AWS resource name it will be visibly wrong
  # (a literal @FIELD@) rather than silently substituted with nothing.
  #  $text =~ s/[@](\w+)[@]/ exists $subst->{$1} ? $subst->{$1} : "\@$1\@" /xsmge;

  $text =~ s{[@](\w+)[@]}{ defined $subst->{$1} ? $subst->{$1} : q{} }xsmge;

  return YAML::Tiny->read_string($text)->[0];
}

########################################################################
sub _lambda_env_needs_regen {
########################################################################
  my ( $self, $mapping_version ) = @_;

  my $yaml_file = $self->_yaml_file;
  my $env_file  = $self->_env_file;

  return $FALSE if !-e $yaml_file;
  return $TRUE  if !-e $env_file;

  if ( ( stat $yaml_file )[9] > ( stat $env_file )[9] ) {
    return $TRUE;
  }

  open my $fh, '<', $env_file
    or return $TRUE;

  my $first_line = <$fh>;

  close $fh;

  if ( $first_line =~ /mapping \s v([0-9.]+)/xsm ) {
    my $line_version = $1;
    return $TRUE if $line_version ne $mapping_version;
  }
  else {
    print {*STDERR} "no mapping version\n";
    return $TRUE;
  }

  return $FALSE;
}

########################################################################
sub _generate_lambda_env {
########################################################################
  my ($self) = @_;

  require YAML::Tiny;

  my $yaml_file = $self->_yaml_file;
  my $env_file  = $self->_env_file;

  # The mapping version gates regeneration; load once (no substitution
  # needed) just to read the version and decide whether to proceed.
  my $mapping_version = $self->_load_mapping->{version};

  return
    if !$self->_lambda_env_needs_regen($mapping_version);

  my $yaml = eval { YAML::Tiny->read($yaml_file); };

  if ( !$yaml ) {
    $self->get_logger->warn("could not parse $yaml_file: $EVAL_ERROR");
    return;
  }

  my $config = $yaml->[0];

  # Re-load the mapping with @FIELD@ tokens interpolated from values the
  # user supplied in lambda.yaml (e.g. FUNCTION_NAME <- lambda.name), so
  # the mapping's derived defaults (REPO_NAME/ROLE_NAME/RULE_NAME) are
  # already concrete when we walk them.
  my $mapping_doc = $self->_load_mapping( $self->_mapping_subst($config) );

  my $trigger_type = _yaml_get( $config, 'trigger.type' );

  my @lines;
  my $prev_section;

  foreach my $entry ( @{ $mapping_doc->{mapping} } ) {

    # Skip fields that don't apply to this project's trigger type (e.g.
    # trigger.bucket/BUCKET_NAME is s3-sqs-only and must not block
    # regeneration for an sns- or eventbridge-typed lambda.yaml).
    if ( $entry->{applies_to} ) {
      next if !defined $trigger_type || !grep { $_ eq $trigger_type } @{ $entry->{applies_to} };
    }

    my $path  = $entry->{yaml};
    my $var   = $entry->{env};
    my $value = _yaml_get( $config, $path );

    # Not supplied in lambda.yaml: fall back to the (already-interpolated)
    # mapping default instead of dropping the field, so lambda.env is
    # self-complete and REPO_NAME/ROLE_NAME/RULE_NAME carry the values
    # derived from FUNCTION_NAME rather than relying on Makefile fallbacks.
    if ( !defined $value ) {
      if ( $entry->{required} ) {
        $self->get_logger->warn("$path is required in $yaml_file (maps to $var) - not regenerating $env_file");
        return;
      }

      next
        if !exists $entry->{default};

      $value = $entry->{default};
    }

    next if $entry->{omit_if_false} && !$value;

    my ($section) = split /[.]/xsm, $path;

    if ( @lines && $section ne $prev_section ) {
      push @lines, q{};
    }

    $prev_section = $section;
    push @lines, sprintf '%-20s= %s', $var, $value;
  }

  my $header = sprintf <<'END_HEADER', $mapping_version;
# lambda.env - GENERATED from lambda.yaml by alr-builder (mapping v%s)
# Hand edits will be overwritten. Edit lambda.yaml instead, or
# delete lambda.yaml to make this file hand-editable.
END_HEADER

  open my $fh, '>', $env_file
    or do {
    $self->get_logger->warn("could not open $env_file for writing: $OS_ERROR");
    return;
    };

  print {$fh} $header;
  print {$fh} "\n";
  print {$fh} join( "\n", @lines ), "\n";

  close $fh;

  $self->get_logger->info("regenerated $env_file from $yaml_file");

  return;
}

########################################################################
sub _yaml_set {
########################################################################
  my ( $node, $path, $value ) = @_;

  my @keys = split /[.]/xsm, $path;
  my $last = pop @keys;

  foreach my $key (@keys) {
    $node->{$key} //= {};
    $node = $node->{$key};
  }

  $node->{$last} = $value;

  return;
}

########################################################################
sub _walk_mapping {
########################################################################
  my ( $self, $provided ) = @_;

  # Load the mapping with @FIELD@ tokens interpolated from the values
  # already present in lambda.env (e.g. FUNCTION_NAME), so the reported
  # defaults match what the writer would produce.
  my $mapping_doc = $self->_load_mapping( { FUNCTION_NAME => $provided->{FUNCTION_NAME} } );

  my $trigger_type = $provided->{TRIGGER_TYPE} // $mapping_doc->{trigger_types}[0];

  my ( @missing, @defaulted, @customized );

  foreach my $entry ( @{ $mapping_doc->{mapping} } ) {
    if ( $entry->{applies_to} ) {
      next if !grep { $_ eq $trigger_type } @{ $entry->{applies_to} };
    }

    my $var     = $entry->{env};
    my $value   = $provided->{$var};
    my $default = $entry->{default};  # already interpolated at load time

    if ( !defined $value ) {
      if ( $entry->{required} ) {
        push @missing, $entry;
      }
      elsif ( defined $default ) {
        push @defaulted, [ $entry, $default ];
      }

      next;
    }

    if ( $entry->{omit_if_false} && !$value ) {
      push @defaulted, [ $entry, $value ];
      next;
    }

    if ( defined $default && "$value" eq "$default" ) {
      push @defaulted, [ $entry, $value ];
    }
    else {
      push @customized, [ $entry, $value ];
    }
  }

  return {
    trigger_type => $trigger_type,
    missing      => \@missing,
    defaulted    => \@defaulted,
    customized   => \@customized,
  };
}

########################################################################
sub _validate_constraints {
########################################################################
  my ( $self, $provided ) = @_;

  my @warnings;

  my $trigger_type = $provided->{TRIGGER_TYPE};

  my %check = (
    alb => sub {
      my ($provided) = @_;
      my $listener_arn = $provided->{LISTENER_ARN} // q{};

      if ( $listener_arn !~ /^arn:aws:elasticloadbalancing:/xsm ) {
        push @warnings, sprintf 'LISTENER_ARN (%s) does not look like a valid ELBv2 listener ARN', $listener_arn;
      }

      return;
    },
    's3-sqs' => sub {
      my ($provided) = @_;

      my $timeout    = $provided->{TIMEOUT}            // 0;
      my $visibility = $provided->{VISIBILITY_TIMEOUT} // 0;

      if ( $visibility < $timeout * 6 ) {
        push @warnings,
          sprintf 'VISIBILITY_TIMEOUT (%d) should be at least 6x TIMEOUT (%d) - recommended minimum is %d seconds',
          $visibility, $timeout, $timeout * 6;
      }

      return;
    },
    'eventbridge' => sub {return},  # no constraints (or add SCHEDULE check)
    'sns'         => sub {return},  # no constraints (or add TOPIC_NAME check)
    's3-direct'   => sub {return},  # no constraints (or add BUCKET check)
  );

  $check{$trigger_type}->($provided);

  return @warnings;
}

########################################################################
sub cmd_generate_yaml {
########################################################################
  my ($self) = @_;

  my $env_file  = $self->_env_file;
  my $yaml_file = $self->_yaml_file;

  die "ERROR: $env_file not found in current directory\n"
    if !-e $env_file;

  die "ERROR: $yaml_file already exists - remove it first to regenerate\n"
    if -e $yaml_file;

  my %provided = $self->_read_lambda_env;

  my $result = $self->_walk_mapping( \%provided );

  if ( @{ $result->{missing} } ) {
    my @names = map { sprintf '%s (%s)', $_->{env}, $_->{yaml} } @{ $result->{missing} };
    die "ERROR: cannot generate $yaml_file - missing required values:\n  " . join( "\n  ", @names ) . "\n";
  }

  my $config = { trigger => { type => $result->{trigger_type} } };

  foreach my $pair ( @{ $result->{customized} } ) {
    my ( $entry, $value ) = @{$pair};
    _yaml_set( $config, $entry->{yaml}, $value );
  }

  require YAML::Tiny;
  YAML::Tiny->new($config)->write($yaml_file);

  $self->get_logger->info("wrote $yaml_file from $env_file");

  return $SUCCESS;
}

########################################################################
sub _read_lambda_env {
########################################################################
  my ($self) = @_;

  my $env_file = $self->_env_file;
  my %env;

  return %env if !-e $env_file;

  open my $fh, '<', $env_file
    or die "ERROR: could not open $env_file\n$OS_ERROR";

  while ( my $line = <$fh> ) {
    next if $line =~ /^\s*[#]/xsm || $line !~ /\S/xsm;

    if ( $line =~ /^\s* (\w+) \s* = \s* (.*?) \s*$/xsm ) {
      $env{$1} = $2;
    }
  }

  close $fh;

  return %env;
}

########################################################################
sub cmd_check {
########################################################################
  my ($self) = @_;

  my %provided = $self->_read_lambda_env;

  my $result = $self->_walk_mapping( \%provided );

  my @warnings = $self->_validate_constraints( \%provided );

  if (@warnings) {
    print {*STDOUT} "Constraint violations:\n";
    foreach (@warnings) {
      printf {*STDOUT} "  %s\n", $_;
    }
    print {*STDOUT} "\n";
  }

  if ( @{ $result->{missing} } ) {
    print {*STDOUT} "MISSING (required):\n";

    foreach my $entry ( @{ $result->{missing} } ) {
      printf {*STDOUT} "  %-22s (%s)\n", $entry->{env}, $entry->{yaml};
    }

    print {*STDOUT} "\n";
  }
  else {
    print {*STDOUT} "All required fields present.\n\n";
  }

  if ( @{ $result->{customized} } ) {
    print {*STDOUT} "Customized:\n";

    foreach my $pair ( @{ $result->{customized} } ) {
      my ( $entry, $value ) = @{$pair};
      printf {*STDOUT} "  %-22s = %s\n", $entry->{env}, $value;
    }

    print {*STDOUT} "\n";
  }

  if ( @{ $result->{defaulted} } ) {
    print {*STDOUT} "Using defaults:\n";

    foreach my $pair ( @{ $result->{defaulted} } ) {
      my ( $entry, $value ) = @{$pair};
      printf {*STDOUT} "  %-22s = %s\n", $entry->{env}, $value;
    }
  }

  return @{ $result->{missing} } ? $FAILURE : $SUCCESS;
}

1;
