package Amazon::Lambda::Runtime::Builder;

use strict;
use warnings;

use Carp;
use Carp::Always;
use Cwd qw(getcwd);
use CLI::Simple::Constants qw(:booleans :chars);
use CLI::Simple::Utils qw(choose slurp slurp_json);
use Data::Dumper;
use File::ShareDir qw(dist_dir);
use File::Basename qw(basename);
use File::Path qw(make_path);
use English qw(-no_match_vars);
use List::Util qw(max none pairs);
use POSIX qw(strftime);
use Time::HiRes;

use Readonly;
Readonly my $LOG_RETENTION_DAYS => 7;  # TODO: override from .alr-builderrc

use Role::Tiny::With;

with 'Amazon::Lambda::Runtime::Builder::Role::CheckDeps';
with 'Amazon::Lambda::Runtime::Builder::Role::Config';
with 'Amazon::Lambda::Runtime::Builder::Role::Install';

Readonly::Scalar our $LOG4PERL_CONF => <<'END_OF_CONF';
log4perl.logger = INFO, Screen
log4perl.appender.Screen = Log::Log4perl::Appender::ScreenColoredLevels
log4perl.appender.Screen.stderr = 1
log4perl.appender.Screen.layout = Log::Log4perl::Layout::PatternLayout
log4perl.appender.Screen.layout.ConversionPattern = [%d] %m%n
log4perl.appender.Screen.color.DEBUG=magenta
log4perl.appender.Screen.color.INFO=green
log4perl.appender.Screen.color.WARN=yellow
log4perl.appender.Screen.color.ERROR=red
log4perl.appender.Screen.color.FATAL=bold red
log4perl.appender.Screen.color.TRACE=bold white
END_OF_CONF

__PACKAGE__->use_log4perl( level => 'info', config => $LOG4PERL_CONF );

our $VERSION = '@PACKAGE_VERSION@';

use parent qw(CLI::Simple);

caller or __PACKAGE__->main();

########################################################################
sub init {
########################################################################
  my ($self) = @_;

  my $dist_dir = dist_dir('Amazon-Lambda-Runtime-Builder');

  my $manifest = slurp_json( sprintf '%s/MANIFEST.json', $dist_dir );

  $self->set_manifest($manifest);
  $self->set_dist_dir($dist_dir);

  if ( $self->get_profile ) {
    $ENV{AWS_PROFILE} = $self->get_profile;
  }

  my ($config) = grep { defined $_ } ( $self->get_config_file, @ENV{qw(LAMBDA_ENV LAMBDA_YAML)} );
  $config //= 'lambda.env';

  $self->set_config_file($config);

  eval { $self->_generate_lambda_env };

  if ($EVAL_ERROR) {
    $self->get_logger->warn("lambda.env generation skipped: $EVAL_ERROR");
  }

  if ( $self->get_color ) {
    eval { require Term::ANSIColor; };
    $self->set_color( !$EVAL_ERROR );
  }

  return;
}

########################################################################
sub init_logger {
########################################################################
  my ($self) = @_;

  if ( !$self->get_color ) {
    $self->set_log4perl_conf(undef);
  }

  return $self->SUPER::init_logger;
}

########################################################################
sub _load_lambda_env {
########################################################################
  my ($self) = @_;

  my $file = 'lambda.env';
  return if !-e $file;

  open my $fh, '<', $file or return;

  while ( my $line = <$fh> ) {
    chomp $line;
    next if $line =~ /\A\s*[#]/xsm;  # comments
    next if $line !~ /\S/;  # blank

    my ( $key, $value ) = $line =~ /\A\s*(\w+)\s*=\s*(.*?)\s*\z/xsm;
    next if !defined $key;

    $ENV{$key} //= $value;  # //= so a real env override wins
  }

  close $fh;

  return;
}

########################################################################
sub cmd_teardown_lambda {
########################################################################
  my ($self) = @_;

  return $self->_run_pipeline( 'lambda-teardown', $self->get_args );
}

########################################################################
sub cmd_build_lambda {
########################################################################
  my ($self) = @_;

  return $self->_run_pipeline( 'lambda-pipeline', $self->get_args );
}

########################################################################
sub _run_pipeline {
########################################################################
  my ( $self, $target, @make_args ) = @_;

  $self->_load_lambda_env;

  my $t0 = Time::HiRes::time();

  my $function_name = $ENV{FUNCTION_NAME};

  die "ERROR: unable to determine function name\n"
    if !$function_name;

  my $cache_dir = $ENV{CACHE_DIR} // sprintf '.cache/%s', $function_name;
  make_path($cache_dir);
  local $ENV{CACHE_DIR} = $cache_dir;

  my $stamp = strftime '%Y%m%d-%H%M%S', localtime;
  my $log   = sprintf '%s/build-%s.log', $cache_dir, $stamp;
  my $link  = 'build.log';

  if ( -l $link || -e $link ) {
    unlink $link;
  }

  symlink $log, $link
    or warn "symlink: $OS_ERROR";

  $self->_prune_logs($cache_dir);

  # status channel: a pipe. child (make -> report-step) writes the
  # write-end; we read the read-end here and render.
  local $^F = 10;

  pipe my ( $status_r, $status_w )
    or die "pipe failed: $OS_ERROR";

  my $pid = fork // die "fork failed: $OS_ERROR";

  if ( !$pid ) {
    # ---- child: run make ----
    close $status_r;

    # put the status pipe on a known fd and tell report-step via env
    my $fd = fileno $status_w;
    $ENV{ALR_STATUS_FD} = $fd;

    # make's own stdout+stderr (docker/aws noise) -> build.log
    open STDOUT, '>>', $log     or die "reopen stdout: $OS_ERROR";
    open STDERR, '>&', \*STDOUT or die "reopen stderr: $OS_ERROR";

    # verbose output
    if ( none { $_ =~ /NO_ECHO/xsm } @make_args ) {
      push @make_args, 'NO_ECHO=';
    }

    # exec make; the status pipe fd stays open across exec (no close-on-exec)
    exec 'make', '-f', 'Makefile.builder', $target, @make_args
      or die "exec make failed: $OS_ERROR";
  }

  # ---- parent: read + render the status stream ----
  close $status_w;

  binmode STDOUT, ':encoding(UTF-8)';

  my %started;

  my $t1;

  while ( my $line = <$status_r> ) {
    chomp $line;
    my %ev = $line =~ /(\w+)=(\S+)/xsmg;  # step=deploy status=start ...
    $self->render_status( \%ev, \%started );
  }

  close $status_r;

  waitpid $pid, 0;
  my $rc = $CHILD_ERROR >> 8;

  # at the end, after waitpid / rc:
  my $total_ms = int( ( Time::HiRes::time() - $t0 ) * 1000 );

  printf "%s %s in %s\n", $target, $rc ? 'failed' : 'complete', $self->_fmt_elapsed($total_ms);

  if ($rc) {
    print {*STDERR} "\nSee $log\n";
    $self->tail_file( $log, 40 );
  }

  return $rc;
}

########################################################################
sub cmd_report_step {
########################################################################
  my ( $self, @args ) = @_;

  my ( $target, $step, $status, @extra ) = choose {
    return $self->get_args
      if !@args;

    return @args;
  };

  die "ERROR: usage: report-step <make-target> <step> <status> [key=value ...]\n"
    if !$target || !$step;

  my @vars = ( target => $target, step => $step, status => $status // q{}, @extra );
  my @line;

  foreach my $p ( pairs @vars ) {
    push @line, sprintf '%s=%s', @{$p};
  }

  if ( defined $ENV{ALR_STATUS_FD} && open my $fh, '>&=', $ENV{ALR_STATUS_FD} ) {
    print {$fh} sprintf "%s\n", join q{ }, @line;
    close $fh;
  }
  else {  # bare make => stdout
    print {*STDOUT} sprintf "%s\n", join q{ }, @line;
  }

  return $SUCCESS;
}

########################################################################
sub tail_file {
########################################################################
  my ( $self, $file, $nlines ) = @_;

  my @lines = split /\n/, slurp($file);

  my $start = max( 0, scalar(@lines) - $nlines );

  print {*STDERR} join "\n", splice @lines, $start, $nlines;

  return;
}

########################################################################
sub render_status {
########################################################################
  my ( $self, $ev, $state ) = @_;

  my $target = $ev->{target};
  return if !defined $target;

  $target = basename($target);

  my $step   = $ev->{step}   // q{};
  my $status = $ev->{status} // q{};

  if ( $step eq 'start' ) {
    $state->{$target} = Time::HiRes::time();
    $self->_render_output( $status, sprintf "%s %s...\n", $self->_glyph('run'), $target );
    return;
  }

  if ( $step eq 'done' ) {
    my $ms      = $self->_elapsed_ms( $state, $target );
    my $message = sprintf "%s %s %s\n", $self->_glyph( $status || 'ok' ), $target,
      $ms ? sprintf( '(%s)', $self->_fmt_elapsed($ms) ) : q{};
    $self->_render_output( $status, $message );

    return;
  }

  # sub-step START: announce "in progress", start its timer
  if ( $status eq 'start' ) {
    $state->{"$target:$step"} = Time::HiRes::time();
    $self->_render_output( $status, sprintf "    %s %s...\n", $self->_glyph('run'), $step );
    return;
  }

  # sub-step RESULT
  my $ms = $self->_elapsed_ms( $state, "$target:$step" );
  $self->_render_output(
    $status,
    sprintf "    %s %s%s\n",
    $self->_glyph( $status || 'ok' ),
    $step, $ms ? sprintf( ' (%s)', $self->_fmt_elapsed($ms) ) : q{}
  );

  return;
}

########################################################################
sub _render_output {
########################################################################
  my ( $self, $status, $message ) = @_;

  if ( $self->get_color ) {
    my $color = choose {
      return 'green'
        if $status eq 'ok';

      return 'red'
        if $status eq 'fail';

      return 'yellow'
        if $status eq 'not-found';

      return 'bold white'
        if $status eq 'start';

      return 'white';
    };

    $message = Term::ANSIColor::colored( $message, $color );
  }

  print {*STDOUT} $message;

  return;
}

########################################################################
sub _fmt_elapsed {
########################################################################
  my ( $self, $ms ) = @_;

  return q{}
    if !$ms;

  my $min = int( $ms / 60_000 );
  my $sec = ( $ms % 60_000 ) / 1000;  # fractional seconds (NOT int)

  return sprintf '%dm%04.1fs', $min, $sec
    if $min;

  return sprintf '%.1fs', $sec;
}

########################################################################
sub _prune_logs {
########################################################################
  my ( $self, $cache ) = @_;

  my $cutoff = time - ( $LOG_RETENTION_DAYS * 24 * 60 * 60 );

  foreach my $log ( glob "$cache/build-*.log" ) {
    my $mtime = ( stat $log )[9];

    next if !defined $mtime;  # stat failed (race: file vanished) — skip
    next if $mtime >= $cutoff;  # within retention window — keep

    unlink $log
      or warn "could not prune $log: $OS_ERROR";
  }

  return;
}

########################################################################
sub _glyph {
########################################################################
  my ( $self, $kind ) = @_;

  my $utf8 = ( $ENV{LANG} // q{} ) =~ /UTF-?8/xsmi;

  my %sym = $utf8
    ? ( run => "\x{2022}", ok => "\x{2713}", fail => "\x{2717}", 'not-found' => "\x{2013}" )  # –
    : ( run => '>', ok => '[ok]', fail => '[XX]', 'not-found' => '[--]' );

  return $sym{$kind} // ( $utf8 ? "\x{2022}" : '-' );
}

########################################################################
sub _elapsed_ms {
########################################################################
  my ( $self, $state, $key ) = @_;

  my $t0 = $state->{$key};

  return 0 if !$t0;

  return int( ( Time::HiRes::time() - $t0 ) * 1000 );
}

########################################################################
sub main {
########################################################################

  my %commands = (
    'build-lambda'    => \&cmd_build_lambda,
    'teardown-lambda' => \&cmd_teardown_lambda,
    'check'           => \&cmd_dep_check,
    'check-env-file'  => \&cmd_check,
    'generate-yaml'   => \&cmd_generate_yaml,
    'install'         => \&cmd_install,
    'default'         => \&cmd_install,
  );

  my @option_specs = qw(
    help|h
    color!
    config-file|c=s
    install-dir|i=s
    log-level|l=s
    profile|p=s
    force|f
  );

  my $cli = Amazon::Lambda::Runtime::Builder->new(
    commands        => \%commands,
    option_specs    => \@option_specs,
    extra_options   => [qw(dist_dir manifest lambda_env lambda_yaml)],
    abbreviations   => $TRUE,
    default_options => { color => $TRUE },
  );

  $cli->run();

  return $SUCCESS;
}

1;

__END__

=pod

=encoding utf8

=head1 NAME

Amazon::Lambda::Runtime::Builder - scaffolding, environment checker, and
deployment toolchain for Perl Lambda container images

=head1 SYNOPSIS

  # Scaffold a new project in the current directory
  alr-builder install

  # Scaffold into a specific directory
  alr-builder install --install-dir /path/to/my-lambda

  # Verify tools and IAM permissions before your first build
  alr-builder check

  # Build and deploy the Lambda - full pipeline, with progress and logging
  alr-builder build

  # Tear it all down when finished
  alr-builder teardown

  # Validate lambda.env (or lambda.yaml) against this Lambda's requirements
  alr-builder check-env-file

  # Migrate an existing lambda.env to lambda.yaml
  alr-builder generate-yaml

=head1 DESCRIPTION

C<Amazon::Lambda::Runtime::Builder> is the companion deployment tool for
L<Amazon::Lambda::Runtime>. It handles everything outside of the Perl
runtime itself: scaffolding a new project directory, verifying your build
environment, and providing the C<make>-based build/deploy pipeline that
turns a handler distribution into a deployed Lambda function wired to the
one of the supported event sources

Five trigger types are supported - C<s3-sqs>, C<s3-direct>,
C<eventbridge>, C<sns>, and C<alb> - selected with a single
C<TRIGGER_TYPE> value and provisioned by a single command,
C<alr-builder build>. See L</CONFIGURATION> and L</WORKFLOW>.

The C<alr-builder> CLI provides six commands (any command may be
abbreviated to a unique prefix - e.g. C<build> for C<build-lambda>,
C<teardown> for C<teardown-lambda>):

=over 4

=item * B<install> - copies the project scaffold (handler template,
managed-policy list, and the C<make> integration files) into a target
directory.

=item * B<build-lambda> - builds and deploys the Lambda by running the
full pipeline, with live progress and a timestamped build log. Abbreviate
as C<build>.

=item * B<teardown-lambda> - tears the deployment down (same progress and
logging). Abbreviate as C<teardown>.

=item * B<check> - verifies that required system tools are present on
your C<PATH> and, if the optional IAM modules are installed, confirms
that your AWS credentials have sufficient permissions to build and deploy.

=item * B<check-env-file> - validates C<lambda.env> (or C<lambda.yaml>, if
present) against this Lambda's configuration requirements, reporting
missing required values, customized values, and values using defaults.

=item * B<generate-yaml> - migrates an existing, hand-written C<lambda.env>
to a minimal C<lambda.yaml>, the starting point for the generate-on-demand
workflow described in L</CONFIGURATION>.

=back

A second, internal CLI - C<alr-helper> - wraps the AWS API calls the
Makefiles invoke (ECR, IAM, Lambda, SQS, SNS, S3, EventBridge, ELBv2,
CloudWatch Logs, STS). You do not normally call it directly; the
Makefiles do.

Use C<alr-builder build> and C<alr-builder teardown> for the full
build/deploy and teardown lifecycle; they run the C<make> pipeline and add
live per-step progress and a timestamped build log. To run or re-run an
individual step - build just the image, invoke the function, push a
code-only update - call the corresponding C<make> target directly; see
L</MAKEFILE TARGETS>.

=head1 COMMANDS

=head2 install

  alr-builder install [--install-dir DIR] [--force]

Copies the project scaffold into the target directory (defaults to the
current working directory), creating the directory if it does not exist.
The set of installed files is driven by the distribution's
C<share/MANIFEST.json>:

=over 4

=item * C<LambdaHandler.pm> - handler template with stub implementations
for SQS, SNS, S3, and EventBridge events, plus a streaming-response
example for Function URL invocations. Edit it in place or replace it with
your own handler module. Installed with C<overwrite: never> - an existing
copy is left untouched.

=item * C<policies> - AWS managed IAM policy ARNs to attach to the Lambda
execution role. One ARN per line; lines beginning with C<#> are comments.
Installed with C<overwrite: never>.

=item * C<Makefile.builder> - the build engine. A thin wrapper, safe to
regenerate, that C<include>s the framework's C<Makefile.mk> from this
distribution's share directory - this is where the real target recipes
live. Installed with C<overwrite: always> - safe to regenerate and safe
to commit. Two ways to invoke it directly:

=over 4

=item * B<As-is> - C<make -f Makefile.builder E<lt>targetE<gt>>.

=item * B<As your C<Makefile>> - rename or symlink it: C<mv
Makefile.builder Makefile>, then plain C<make E<lt>targetE<gt>> works.
Simplest if you don't already have a project C<Makefile>.

=back

=item * C<project.mk> - for projects that already have their own
C<Makefile>: C<include project.mk> to pull in the same target names
(C<lambda-pipeline>, C<update-function>, and so on) alongside whatever
else your C<Makefile> does. Each target it defines sub-makes into
C<Makefile.builder> by that literal filename, so B<C<Makefile.builder>
must stay present in the project directory> even when you're driving
everything through C<project.mk> - it is not a replacement for
C<Makefile.builder>, just an alternate front door to it. If
C<project.mk> already exists, the ALRB integration block is appended
between marker comments and a C<project.mk.bak> backup is written; an
already-integrated C<project.mk> is left unchanged.

=back

The Dockerfile, the trigger Makefiles (C<sqs.mk>, C<sns.mk>, C<s3.mk>,
C<eventbridge.mk>, C<alb.mk>, C<streaming.mk>), and the platform/overlay/
log-group fragments are B<not> copied into the project - they are read
from this distribution's share directory at build time. The C<cpanfile>
used to build the image is generated on demand from your distribution
tarball's C<META.json> (see L</WORKFLOW>).

Use C<--force> to overwrite a file whose manifest policy would otherwise
refuse to replace it.

=head2 build-lambda

  alr-builder build-lambda [VAR=value ...]
  alr-builder build                          # abbreviation

Builds and provisions the Lambda for the configured C<TRIGGER_TYPE> by
running the framework's pipeline (C<make -f Makefile.builder
lambda-pipeline>). Run it from a configured project directory.  Before
invoking the build pipeline, C<alr-builder> ensures C<lambda.env>
reflects the current C<lambda.yaml>, when that workflow is in use.
The build requires a configured function name and will abort if
C<FUNCTION_NAME> is unset.

This is the recommended way to build. Over a bare C<make lambda-pipeline>
it adds:

=over 4

=item * live, per-step progress rendered as the pipeline runs;

=item * a timestamped build log at
C<.cache/E<lt>function-nameE<gt>/build-E<lt>timestampE<gt>.log>, symlinked
in the current directory as C<build.log> (older logs are pruned
automatically);

=item * an elapsed-time summary on completion, and on failure the tail of
the log plus its path.

=back

Any trailing C<VAR=value> arguments are passed through to C<make>. Returns
C<make>'s exit status. Abbreviate as C<alr-builder build>.

=head2 teardown-lambda

  alr-builder teardown-lambda [VAR=value ...]
  alr-builder teardown                       # abbreviation

Tears the deployment down by running the C<lambda-teardown> target, with
the same progress rendering, timestamped logging, argument pass-through,
and exit-status behavior as L</build-lambda>. See L</WORKFLOW> (Phase 3)
for exactly what is and isn't removed - notably, the SQS queue and the
platform ECR repository are left in place by design. Abbreviate as
C<alr-builder teardown>.

=head2 check

  alr-builder check

Verifies that your environment is ready to build and deploy. Checks two
things:

B<Required system tools> - C<docker> and C<make> must be on your
C<PATH>. C<curl> is checked as an optional tool. The tool list comes from
C<MANIFEST.json>. Missing required tools are reported as errors.

B<IAM permissions> - if L<Amazon::API::IAM>, L<Amazon::API::STS>, and
L<Amazon::Credentials> are installed, calls C<SimulatePrincipalPolicy>
using your current credentials to confirm your IAM identity has the
permissions required to build and deploy. See L</REQUIRED IAM PERMISSIONS>
for the full list.

If the IAM modules are not installed, tool checks still run but permission
checking is skipped with a warning.

=head2 check-env-file

  alr-builder check-env-file

Validates the project's configuration against this Lambda's requirements
(see L</CONFIGURATION>). Reads C<lambda.env> if present - an absent
C<lambda.env> is treated as "nothing configured yet", useful for seeing
the full set of required and defaulted values for a brand-new project -
and reports three groups:

=over 4

=item * B<MISSING (required)> - required values with no default that are
not set. C<image.handler> (C<HANDLER_CLASS>) and C<trigger.type>
(C<TRIGGER_TYPE>) are required for every trigger type. Each trigger type
adds its own required values: C<trigger.bucket> (C<BUCKET_NAME>) for
C<s3-sqs> and C<s3-direct>, C<trigger.topic_name> (C<TOPIC_NAME>) for
C<sns>, and C<trigger.listener_arn> (C<LISTENER_ARN>) for C<alb>.

=item * B<Customized> - values present in C<lambda.env> that differ from
their C<lambda-mapping.yml> default, or have no default at all.

=item * B<Using defaults> - values not set in C<lambda.env>, and the
default that applies in their place.

=back

Fields are scoped to the active C<trigger.type> via C<lambda-mapping.yml>'s
C<applies_to>, so only the values relevant to your trigger are reported.
Exits non-zero if any required values are missing.

=head2 generate-yaml

  alr-builder generate-yaml

Migrates an existing C<lambda.env> to C<lambda.yaml>. Requires
C<lambda.env> to exist and C<lambda.yaml> to not already exist - this is a
one-time migration step, not something to re-run once C<lambda.yaml> is
your source of truth (see L</CONFIGURATION>).

Performs the same validation as C<check-env-file> first; if any required
values are missing, no C<lambda.yaml> is written and the missing fields
are reported instead. Otherwise, writes a minimal C<lambda.yaml>
containing only values that differ from their defaults (plus any field
with no default) - fields matching their default are omitted, since
C<Makefile.mk> applies the same defaults via C<lambda-mapping.yml>.

=head1 OPTIONS

=over 4

=item C<--color|--no-color>

Turns color status messages printed during a build or teardown on or off.

=item C<--install-dir|-i> DIR

Target directory for C<install>. Defaults to the current working directory.

=item C<--config-file|-c> FILE

Configuration file to read. Defaults to C<lambda.env> (falling back to the
C<LAMBDA_ENV>/C<LAMBDA_YAML> environment variables).

=item C<--profile|-p> NAME

AWS named profile to use for this invocation. Sets C<AWS_PROFILE> for the
credential lookups performed by C<check>.

=item C<--force|-f>

Overwrite scaffold files during C<install> that would otherwise be
preserved by their manifest policy.

=item C<--log-level|-l> LEVEL

Log verbosity. Accepts Log4perl level names: C<trace>, C<debug>, C<info>
(default), C<warn>, C<error>, C<fatal>.

=item C<--help|-h>

Display usage information.

=back

=head1 CONFIGURATION

The build pipeline ultimately consumes C<lambda.env>, a flat
C<KEY = value> file read by C<Makefile.mk>.  Project configuration can
either be maintained directly in that file or expressed in
C<lambda.yaml>, from which C<alr-builder> generates C<lambda.env>.

=over 4

=item * B<Hand-written> - edit C<lambda.env> directly. This is the
original, and still fully supported, workflow. Run C<alr-builder
check-env-file> to verify it against C<lambda-mapping.yml>'s requirements.

=item * B<Generated from lambda.yaml> - write a C<lambda.yaml> describing
only the values that matter for your Lambda; everything else comes from
C<lambda-mapping.yml>'s defaults. C<alr-builder> regenerates C<lambda.env>
from C<lambda.yaml> automatically whenever C<lambda.yaml> is newer than
C<lambda.env>, or when C<lambda-mapping.yml>'s mapping version has changed
since C<lambda.env> was last generated. A generated C<lambda.env> begins
with a header noting it is generated; hand edits to it are overwritten
the next time C<lambda.yaml> changes.

=back

To move an existing C<lambda.env> to the C<lambda.yaml> workflow, run
C<alr-builder generate-yaml> once.

=head2 Trigger types

C<trigger.type> (C<TRIGGER_TYPE>) selects the event source and the
pipeline that provisions it:

=over 4

=item * B<s3-sqs> - S3 object events delivered through an SQS queue (with
a dead-letter queue and configurable reserved concurrency). The recommended
pattern for serialized, at-least-once processing.

=item * B<s3-direct> - S3 bucket notifications invoking the Lambda directly.

=item * B<eventbridge> - an EventBridge scheduled rule.

=item * B<sns> - an SNS topic subscription.

=item * B<alb> - an Application Load Balancer listener rule forwarding a
path to the Lambda. C<path> is a B<regular expression> matched against the
request path. Requires an existing ALB; use an HTTPS listener for TLS. The
rule is created on first deploy and modified in place when C<path> or
C<priority> change.

=back

A Function URL with streaming responses is also available for any function
(see C<lambda-function-url> and C<test-streaming> in L</MAKEFILE TARGETS>);
it is independent of C<TRIGGER_TYPE>.

=head2 lambda.yaml structure

Fields common to every trigger type:

  image:
    repo: ...            # ECR repository / image name (REPO_NAME)
    handler: ...         # Perl handler class (HANDLER_CLASS) - required
  lambda:
    name: ...            # function name (FUNCTION_NAME)
    timeout: ...         # seconds (TIMEOUT)
    memory: ...          # MB (MEMORY)
    concurrency: ...     # reserved concurrency (CONCURRENCY)
  role:
    name: ...            # IAM role name (ROLE_NAME)
    profile: ...         # named policy profile (ROLE_PROFILE)
  log_retention: ...     # CloudWatch retention in days (LOG_RETENTION)
  platform_image: ...    # optional platform layer image (PLATFORM_IMAGE)
  overlay: ...           # optional overlay image name (OVERLAY)
  trigger:
    type: ...            # one of s3-sqs, s3-direct, eventbridge, sns, alb - required

Trigger-specific C<trigger:> keys, by C<type>:

  # s3-sqs
  trigger:
    type: s3-sqs
    bucket: ...          # source S3 bucket (BUCKET_NAME) - required
    prefix: ...          # key prefix filter (KEY_PREFIX)
    event: ...           # S3 event type (S3_EVENT)
    queue:
      name: ...                     # (QUEUE_NAME)
      batch_size: ...               # (BATCH_SIZE)
      visibility_timeout: ...       # seconds (VISIBILITY_TIMEOUT)
      retention: ...                # seconds (RETENTION)
      receive_count: ...            # max receives before DLQ (RECEIVE_COUNT)
      partial_batch_response: ...   # true/false (PARTIAL_BATCH_RESPONSE)
      dlq:
        name: ...          # DLQ name (DLQ_NAME)
        retention: ...     # seconds (DLQ_RETENTION)

  # s3-direct
  trigger:
    type: s3-direct
    bucket: ...          # source S3 bucket (BUCKET_NAME) - required
    prefix: ...          # key prefix filter (KEY_PREFIX)
    event: ...           # S3 event type (S3_EVENT)

  # eventbridge
  trigger:
    type: eventbridge
    schedule: ...        # schedule expression (SCHEDULE_EXPRESSION)
    rule_name: ...       # rule name (RULE_NAME)

  # sns
  trigger:
    type: sns
    topic_name: ...      # SNS topic name (TOPIC_NAME) - required

  trigger:
    type: alb
    listener_arn: ...    # existing listener ARN (LISTENER_ARN) - required
    path: ...            # path regex to route (ALB_PATH; default /build)
    priority: ...        # listener-rule priority (RULE_PRIORITY; default 999)

C<priority> defaults to C<999> so that, on a shared ALB, this path-only rule
is evaluated after any host-specific or more-specific rules already present.
On a shared load balancer, prefer adding a host condition to scope the rule
to your own hostname rather than relying on priority ordering alone.

Every field except the ones marked B<required> may be omitted, in which
case C<lambda-mapping.yml>'s default applies. See L</MAKEFILE TARGETS> for
how C<role.profile> is applied.

=head2 config.mk

C<lambda.env>/C<lambda.yaml> hold per-Lambda configuration - the values
that describe I<this> function. Tool-level settings that apply across
every project on a given machine or in a given shell - which AWS profile
or account to use, a DarkPAN resolver, and so on - don't belong there,
since C<lambda.env> may be regenerated from C<lambda.yaml> at any time.

C<config.mk> is an optional C<make> fragment, read via C<-include
config.mk> at the very top of C<Makefile.mk>, before C<lambda.env> is
loaded, for exactly this kind of machine- or shell-local override. C<alr-builder
install> does not create one; if your project's C<Makefile> was
bootstrapped with L<CPAN::Maker::Bootstrapper>, a default C<config.mk> is
already there. Otherwise add it yourself:

  # config.mk
  AWS_PROFILE = my-profile
  AWS_ACCOUNT = 123456789012
  RESOLVER    = 02packages,https://cpan.openbedrock.net/orepan2

Because it loads first, anything set here is a default that C<lambda.env>
and the environment can still override (C<Makefile.mk> uses C<?=> for the
values it reads). Keep it out of version control if it holds
machine-specific or credential-adjacent values - add it to C<.gitignore>.

=head1 WORKFLOW

The typical workflow for a new Lambda function:

=over 4

=item 1.

B<Scaffold the project>:

  alr-builder install --install-dir my-lambda
  cd my-lambda

=item 2.

B<Verify your environment>:

  alr-builder check

=item 3.

B<Implement your handler> - edit the generated
C<lib/I<App>/I<Path>/Lambda/Handler.pm> and the C<Event/*.pm> module for
your trigger type (or replace either with your own), and add their
dependencies to your distribution's C<cpanfile>/C<META.json> as you
introduce them.

=item 4.

B<Configure the Lambda> - C<alr-builder install> already wrote a
C<lambda.yaml> with C<image.handler> and C<trigger.type> set from the
C<app-name>/C<trigger-type> you gave it. Fill in any trigger-specific
required values it doesn't have a default for (e.g. C<trigger.bucket> for
C<s3-sqs>/C<s3-direct>, C<trigger.topic_name> for C<sns>,
C<trigger.listener_arn> for C<alb>), and adjust anything else - function
name, memory, timeout, schedule, and so on - as needed. Run C<alr-builder
check-env-file> to confirm nothing required is still missing (see
L</CONFIGURATION>).

=item 5.

B<Build a CPAN distribution> - turn your handler into a standard CPAN
distribution and produce a tarball. C<make image> resolves
C<DIST_TARBALL> to the most recent C<$(DIST_NAME)-*.tar.gz> in
C<$(BUILDER_HOME)>, where C<DIST_NAME> comes from that distribution's
C<META.json>.

If you don't already have distribution tooling for the project, consider
L<CPAN::Maker::Bootstrapper> - it scaffolds a complete CPAN project from
the assets C<install> just generated:

  cpanm CPAN::Maker::Bootstrapper
  bootstrapper -I . -i . MyApp

After running the bootstrapper you should have a CPAN distribution
tarball in your working directory.

In a project generated by C<CPAN::Maker::Bootstrapper>, subsequent
handler changes can normally be rebuilt by running C<make>. By
default, C<make> scans your files for new dependencies, updates
C<cpanfile>, lints your code (C<perlcritic>, C<perltidy> if
available), and builds the new tarball. Use C<make quick> to skip
linting.

See L<CPAN::Maker::Bootstrapper> for full details.

=item 6.

B<Deploy> - provision the image, role, function, log group, and the event
source for your trigger type in one command:

  alr-builder build

=item 7.

B<Test>:

  make invoke          # or: make test-streaming (Function URL)

=item 8.

B<Deploy subsequent changes>:

  make update-function

=item 9.

B<Tear down> when finished:

  alr-builder teardown

=back

=head2 Phase 1 - Build the container image

C<make image> requires a CPAN distribution tarball
(C<$(DIST_NAME)-*.tar.gz>) to already exist in C<$(BUILDER_HOME)> - see
Workflow step 5.

The image is built in layers:

=over 4

=item * B<perl-lambda-base> - the runtime base image, containing the Perl
interpreter, the C<bootstrap> entrypoint, the C<plambda.pl> driver, and
all C<Amazon::Lambda::Runtime> dependencies. The handler image is built
C<FROM> this base.

=item * B<platform (optional)> - a layer between the base and the handler,
for stable, infrequently-changing artifacts (data files, toolchains,
shared dependencies). Enabled by setting C<PLATFORM_IMAGE> and providing a
C<Dockerfile.platform>; see the C<platform> target.

=item * B<handler> - your distribution, installed on top with C<cpm>.

=back

The framework Dockerfile handles all of this. Build with:

  make image

The builder stage installs your distribution and its prerequisites with
C<cpm> (resolving through C<RESOLVER> if a DarkPAN is configured), then the
final stage copies the installed tree onto C<${PLATFORM_IMAGE}> (default
C<perl-lambda-base:latest>). The handler is selected at build time by class
name:

  ARG HANDLER_CLASS="LambdaHandler"
  ENV LAMBDA_MODULE=${HANDLER_CLASS}
  ENTRYPOINT ["/usr/local/bin/bootstrap"]

C<HANDLER_CLASS> is required (the build errors without it) and is passed
automatically from C<lambda.env>. C<ENV LAMBDA_MODULE> tells C<bootstrap>
which handler class to load.

To reinstall modules that are also under active development - overriding
the versions resolved from CPAN/DarkPAN - list them (one bare
C<Module@version> per line) in a C<requires.reinstall> file in the project
root. When present it is copied into the build context and reinstalled in
a dedicated layer. Because that layer is otherwise cached, change
C<CACHE_BUST> (or the file's contents) to force it to re-run.

=head2 Phase 2 - Provision function and event source

C<alr-builder build> is the single entry point. It runs the
C<make lambda-pipeline> target - adding live progress and a timestamped
build log at C<.cache/E<lt>function-nameE<gt>/build.log> - which:

=over 4

=item 1.

builds the platform image first if C<PLATFORM_IMAGE> is set and a
C<Dockerfile.platform> is present;

=item 2.

dispatches on C<TRIGGER_TYPE> to the matching per-type pipeline
(C<lambda-sqs-pipeline>, C<lambda-s3-pipeline>,
C<lambda-eventbridge-pipeline>, C<lambda-sns-pipeline>, or
C<lambda-alb-pipeline>), each of which builds and pushes the image,
creates the IAM role and attaches policies, creates the function, applies
memory/timeout and the log-group retention policy, and wires the trigger;

=item 3.

builds and applies the C<overlay> image last if C<OVERLAY> is set.

=back

Every step is idempotent and tracked by sentinel files under
C<.cache/$(FUNCTION_NAME)>, so re-running skips work that is already done.

To deploy a code change:

  make update-function

This rebuilds the image, pushes to ECR using the image digest (never
C<:latest>), and updates the function code - and, if C<OVERLAY> is set,
rebuilds and re-applies the overlay.

=head2 Phase 3 - Teardown

  alr-builder teardown

Runs the C<make lambda-teardown> target, which dispatches on
C<TRIGGER_TYPE> to the matching teardown, removes the overlay (if
C<OVERLAY> is set), and deletes the CloudWatch log group. Shared
resources are treated conservatively: an SNS topic is B<not>
deleted by default (it may have other subscribers), and the platform ECR
repository must be removed manually (see C<platform-teardown>).

=head2 The policies files

Two mechanisms control the Lambda execution role's permissions:

=over 4 

=item B<Managed policies>

The C<policies> file autogenerated based on the trigger-type was
created when you installed the project. This file lists AWS managed
policy ARNs, one per line. For some trigger types specific policies
are enabled by uncommenting the policy. Uncomment policies for your
project requirements.

 # required - CloudWatch logging
 arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole

 # uncomment for SQS trigger
 # arn:aws:iam::aws:policy/service-role/AWSLambdaSQSQueueExecutionRole

 # uncomment for S3 read access
 # arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess

=item B<Inline custom policies>

A C<custom-policies.json> (C<CUSTOM_POLICIES_FILE>) document, if
present, is applied as an inline role policy. Use this to scope
permissions to a specific bucket, queue, or topic ARN.

Apply changes at any time with C<make update-policies> (managed + inline),
or C<make update-managed-policies> / C<make update-inline-policies>
individually.

B<Example F<custom-policies.js> File>

 {
   "Version": "2012-10-17",
   "Statement": [
     {
       "Effect": "Allow",
       "Action": [
         "secretsmanager:GetSecretValue",
         "secretsmanager:DescribeSecret"
       ],
       "Resource": "arn:aws:secretsmanager:us-east-1:123456789012:secret:my-app/db-credentials-AbCdEf"
     }
   ]
 }

=back

I<Note:> Receiving an event from a service does not automatically grant
your handler permission to call that service's APIs. An S3 trigger allows
Lambda to invoke your function - it does not allow your function to read
or write S3 objects. Add the appropriate managed policy ARN to C<policies>,
or scope a specific resource in C<custom-policies.json>, then re-run
C<make update-policies>.

=head1 MAKEFILE VARIABLES

For the per-trigger configuration values (queue settings, schedule, topic,
listener, and so on) see L</CONFIGURATION> and C<lambda-mapping.yml>. The
variables below are tool-level or build-level and apply across trigger
types.

=head2 Identity and image

=over 4

=item C<HANDLER_CLASS>

Perl handler B<class> name (e.g. C<LambdaHandler>), not a filename.
Required - the build errors if unset.

=item C<TRIGGER_TYPE>

Event source pattern: C<s3-sqs>, C<s3-direct>, C<eventbridge>, C<sns>, or
C<alb>. Required for C<lambda-pipeline>/C<lambda-teardown>.

=item C<REPO_NAME>

ECR repository and local image name. Default: C<perl-lambda>.

=item C<FUNCTION_NAME>

Lambda function name. Default: C<lambda-handler>.

=item C<ROLE_NAME>

IAM execution role name. Default: C<lambda-role>.

=item C<AWS_PROFILE>

AWS profile. Default: C<default>.

=item C<REGION>

AWS region. Default: C<us-east-1>.

=item C<AWS_ACCOUNT>

AWS account ID. Resolved automatically via C<alr-helper get-account> if
not set. Set it explicitly to avoid the STS call:

  export AWS_ACCOUNT=$(alr-helper get-account)

=item C<BUILDER_HOME>

Directory searched for the distribution tarball. Default: the current
directory.

=item C<DIST_NAME>

Distribution name used to match the tarball. Default: the basename of the
current directory.

=item C<DIST_TARBALL>

The tarball to build. Default: the highest-versioned
C<$(DIST_NAME)-*.tar.gz> in C<$(BUILDER_HOME)>.

=item C<PAYLOAD>

Payload file for C<make invoke>. Default: C<payload-sns.json>.

=back

=head2 Build

=over 4

=item C<RESOLVER>

DarkPAN resolver passed to C<cpm> (e.g.
C<02packages,https://cpan.openbedrock.net/orepan2>). Default: unset (public
CPAN).

=item C<PLATFORM_IMAGE>

Platform layer image the handler image is built C<FROM>. Default: the
Dockerfile's own default, C<perl-lambda-base:latest>.

=item C<OVERLAY>

Overlay image name. When set, C<lambda-pipeline>/C<update-function> build
and apply an overlay image after the handler image.

=item C<EXTRA_BUILD_PACKAGES>

Extra Debian packages installed in the builder stage (for XS modules that
need build-time libraries, e.g. C<libssl-dev>).

=item C<EXTRA_RUNTIME_PACKAGES>

Extra Debian packages for the runtime layer (for XS modules that need
shared libraries at run time).

=item C<CACHE_BUST>

Arbitrary value used to invalidate the C<requires.reinstall> layer.

=item C<NOCACHE>

Passed through to C<docker build> (set to C<--no-cache> to force a clean
build).

=back

=head2 Function configuration and logging

=over 4

=item C<MEMORY>

Function memory in MB. Default: C<128>.

=item C<TIMEOUT>

Function timeout in seconds. Default: C<30>.

=item C<CONCURRENCY>

Reserved concurrency. Default: C<1>.

=item C<LOG_RETENTION>

CloudWatch log-group retention in days. Default: C<1>.

=back

=head2 Policies

=over 4

=item C<POLICIES_FILE>

File of AWS managed policy ARNs. Default: C<policies>.

=item C<CUSTOM_POLICIES_FILE>

Inline role-policy document. Default: C<custom-policies.json>.

=item C<ROLE_PROFILE>

Named profile in C<profiles.yml> whose managed policies are attached
instead of those in C<POLICIES_FILE>.

=back

=head2 Function URL / streaming

=over 4

=item C<INVOKE_MODE>

Lambda Function URL invoke mode. Default: C<RESPONSE_STREAM>.

=back

=head1 MAKEFILE TARGETS

=head2 Primary Targets

=over 4

=item C<lambda-pipeline>

Provision everything for the configured C<TRIGGER_TYPE>: platform image
(if applicable), handler image, ECR push, IAM role and policies, function,
memory/timeout, log-group retention, the event-source wiring, and the
overlay (if C<OVERLAY> is set). This is the target to run - and to re-run
after editing C<lambda.yaml>/C<lambda.env>.

=item C<lambda-teardown>

Deprovision the function and its trigger-type infrastructure, remove the
overlay (if set), and delete the log group.

=item C<lambda-function>

Create (or update) just the Lambda function from the pushed image - a
component of the pipelines.

=item C<update-function>

Deploy a code change: rebuild the image, push to ECR by digest, update the
function code, and re-apply the overlay if C<OVERLAY> is set.

=item C<invoke>

Invoke the function with C<$(PAYLOAD)> and print the response.

=item C<lambda-configuration> / C<update-lambda-configuration>

Apply (or force re-apply) the function's memory and timeout from
C<lambda.env>. C<lambda-configuration> also ensures the log group and its
retention policy exist.

=item C<update-policies>

Re-attach all IAM policies - managed and inline. See
C<update-managed-policies> and C<update-inline-policies> for the halves.

=item C<clean>

Remove local sentinel files. AWS resources are not affected.

=back

=head2 Per-trigger Pipelines

Each provisions the full stack for its trigger type and has a matching
teardown. C<lambda-pipeline> dispatches to the right one based on
C<TRIGGER_TYPE>; run one directly only if you want to bypass the dispatch.

  lambda-sqs-pipeline          / lambda-sqs-teardown
  lambda-s3-pipeline           / lambda-s3-teardown
  lambda-eventbridge-pipeline  / lambda-eventbridge-teardown
  lambda-sns-pipeline          / lambda-sns-teardown
  lambda-alb-pipeline          / lambda-alb-teardown

=head2 Event Trigger and Function URL Targets

=over 4

=item C<lambda-sqs-trigger>

Creates the SQS queue and DLQ and attaches the queue as an event source. A
component of C<lambda-sqs-pipeline>.

=item C<lambda-s3-trigger>

Configures S3 bucket notifications to invoke the Lambda on C<S3_EVENT>
events (used by C<s3-direct>; C<s3-sqs> routes S3 notifications to the
queue instead).

=item C<lambda-sns-trigger>

Subscribes the Lambda to the SNS topic (creating the topic and permission
as needed).

=item C<lambda-eventbridge-trigger>

Registers the Lambda as the target of the EventBridge rule.

=item C<enable-eventbridge-rule> / C<disable-eventbridge-rule>

Enables or disables the EventBridge rule without deleting infrastructure.

=item C<delete-eventbridge-rule>

Removes targets and deletes the rule.

=item C<lambda-function-url>

Creates a Lambda Function URL with C<auth-type NONE> and
C<InvokeMode=$(INVOKE_MODE)>.

=item C<test-streaming>

Invokes the Function URL with C<curl -sN> to test streaming responses.

=back

=head2 Image Layer Targets

=over 4

=item C<platform> / C<platform-teardown>

Build and push the platform layer image from C<Dockerfile.platform>, then
invalidate the handler-image sentinels so the next build picks it up.
Teardown clears the sentinels; the ECR repository must be deleted
manually.

=item C<overlay> / C<overlay-teardown>

Build an overlay image and update the Lambda function to it directly.
Teardown deletes the overlay ECR repository and clears its sentinels.

=item C<log-group> / C<log-group-teardown>

Create the function's CloudWatch log group and set its retention policy
(C<LOG_RETENTION>); teardown deletes the log group. C<log-group> is a
dependency of C<lambda-configuration>.

=back

=head2 Internal Targets

Called automatically as dependencies - you should not need to invoke these
directly:

C<image> - builds the Docker image.
C<tarball-validated> - verifies the tarball contains C<HANDLER_CLASS>.
C<ecr-repo> - creates the ECR repository (with lifecycle policy) if absent.
C<deploy> - logs in to ECR and pushes the image.
C<image-digest> - resolves the pushed image's digest.
C<lambda-role> - creates the IAM execution role if absent.
C<lambda-managed-policies> / C<lambda-inline-policies> - attach managed and
inline policies.
C<lambda-concurrency> - sets reserved concurrency via
C<PutFunctionConcurrency>.
C<lambda-sqs-response-types> - sets the SQS event source mapping's
C<FunctionResponseTypes> from C<PARTIAL_BATCH_RESPONSE>.
C<policy-document> - generates the IAM assume-role trust policy JSON.
The image build also derives a C<cpanfile> and Debian package list from the
distribution tarball on the fly.

=head1 REQUIRED IAM PERMISSIONS

The C<check> command verifies the following baseline permissions via
C<SimulatePrincipalPolicy>.  They cover the common build-and-deploy path;
some trigger-specific features and teardown operations require additional
permissions listed below.

=head3 ECR

 ecr:CreateRepository         ecr:DescribeRepositories
 ecr:GetAuthorizationToken    ecr:BatchCheckLayerAvailability
 ecr:PutImage                 ecr:InitiateLayerUpload
 ecr:UploadLayerPart          ecr:CompleteLayerUpload
 ecr:PutLifecyclePolicy       ecr:GetLifecyclePolicy

=head3 IAM

 iam:GetRole                  iam:CreateRole
 iam:AttachRolePolicy         iam:PassRole
 iam:ListAttachedRolePolicies

B<Note:> C<iam:PassRole> is frequently overlooked. Its absence produces
a confusing C<InvalidParameterValueException> stating the role cannot be
assumed by Lambda even though the role exists and appears correct.

=head3 Lambda

 lambda:GetFunction              lambda:CreateFunction
 lambda:UpdateFunctionCode       lambda:UpdateFunctionConfiguration
 lambda:GetFunctionConfiguration lambda:InvokeFunction
 lambda:CreateEventSourceMapping lambda:ListEventSourceMappings
 lambda:GetPolicy                lambda:AddPermission
 lambda:RemovePermission         lambda:CreateFunctionUrlConfig
 lambda:GetFunctionUrlConfig     lambda:DeleteFunctionUrlConfig

=head3 SQS / SNS / S3 / EventBridge / STS

 sqs:ListQueues                  sqs:CreateQueue
 sns:ListTopics                  sns:CreateTopic
 sns:Subscribe                   sns:GetTopicAttributes
 s3:CreateBucket                 s3:ListBuckets
 s3:PutBucketNotificationConfiguration
 events:DescribeRule             events:PutRule
 events:PutTargets               events:RemoveTargets
 events:DeleteRule               events:EnableRule
 events:DisableRule
 sts:GetCallerIdentity

=head3 Additional permissions (not verified by check)

Some features and teardown paths call APIs that C<check> does not yet
simulate. You will need these in addition to the list above when the
corresponding feature is used:

=over 4

=item * B<CloudWatch Logs> (C<log-group> / retention): C<logs:CreateLogGroup>,
C<logs:PutRetentionPolicy>, C<logs:DescribeLogGroups>,
C<logs:DeleteLogGroup>, C<logs:DeleteRetentionPolicy>.

=item * B<ALB triggers>: C<elasticloadbalancing:*> for target groups and
listener rules (C<CreateTargetGroup>, C<RegisterTargets>, C<CreateRule>,
C<ModifyRule>, C<DescribeTargetGroups>, C<DescribeRules>, and their
C<Delete>/C<Deregister> counterparts).

=item * B<Inline custom policies> (C<custom-policies.json>):
C<iam:PutRolePolicy> (and C<iam:DeleteRolePolicy> for teardown).

=item * B<Reserved concurrency>: C<lambda:PutFunctionConcurrency>.

=item * B<Full lifecycle / teardown>: broader C<sqs:*>, C<sns:*>, and
C<s3:*> operations (queue/subscription/notification deletion, attribute
reads) beyond the create-and-list actions above.

=back

=head3 Handler Runtime Permissions

C<AWSLambdaBasicExecutionRole> covers CloudWatch logging only. Any AWS
APIs your handler calls directly need additional policies. C<install>
writes a C<policies> file pre-populated for your trigger type; for
anything a managed policy doesn't cover, or where you want tighter,
resource-scoped permissions, add a hand-written IAM policy document as
C<custom-policies.json> and it's applied as an inline role policy
alongside the managed ones.

=head1 SEE ALSO

L<Amazon::Lambda::Runtime> - the runtime library your handler inherits from

L<Amazon::Credentials> - credential provider used for IAM permission checking

L<Amazon::API::IAM>, L<Amazon::API::STS> - AWS API clients used by C<check>

